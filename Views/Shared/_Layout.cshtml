<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ Thống Văn Bằng Số</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
        }
        .navbar-brand {
            font-weight: 600;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4 shadow-sm">
            <div class="container">
                <a class="navbar-brand" href="/">Hệ Thống Văn Bằng Số</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold" href="/Home/TraCuu">Tra Cứu Văn Bằng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/VanBangChungChi">Quản lý Văn Bằng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/DonViPhatHanh">Đơn vị Phát Hành</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/NguoiNhan">Người Nhận</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/KhoaKySo">Khóa Ký Số</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/LichSuKiemTra">Lịch Sử Kiểm Tra</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/swagger">API Docs</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - Hệ Thống Văn Bằng Số
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
