@model HeThongVanBangSo.Models.NguoiNhan

@{
    ViewData["Title"] = "Sửa Thông Tin Người Nhận";
}

<div class="form-section mt-3">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">Chỉnh sửa Thông Tin Người Nhận</h5>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaNguoiNhan" />

                <div class="mb-3">
                    <label asp-for="HoTen" class="form-label fw-semibold">Họ và Tên <span class="text-danger">*</span></label>
                    <input asp-for="HoTen" class="form-control" />
                    <span asp-validation-for="HoTen" class="field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SoCCCD" class="form-label fw-semibold">Số CCCD/CMND <span class="text-danger">*</span></label>
                    <input asp-for="SoCCCD" class="form-control" />
                    <span asp-validation-for="SoCCCD" class="field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NgaySinh" class="form-label fw-semibold">Ngày sinh <span class="text-danger">*</span></label>
                    <input asp-for="NgaySinh" class="form-control" type="date" />
                    <span asp-validation-for="NgaySinh" class="field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <hr />
                <div class="d-flex justify-content-between">
                    <a href="/NguoiNhan" class="btn btn-outline-secondary">← Quay lại danh sách</a>
                    <button type="submit" class="btn btn-warning">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
