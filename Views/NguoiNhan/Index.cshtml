@model IEnumerable<HeThongVanBangSo.Models.NguoiNhan>

@{
    ViewData["Title"] = "Người Nhận";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="text-primary">Danh sách Người Nhận</h2>
    <a href="/NguoiNhan/Create" class="btn btn-success">+ Thêm Người Nhận</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mã</th>
                        <th>Họ Tên</th>
                        <th>Số CCCD/CMND</th>
                        <th>Ngày Sinh</th>
                        <th>Email</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.MaNguoiNhan</strong></td>
                                <td>@item.HoTen</td>
                                <td>@item.SoCCCD</td>
                                <td>@item.NgaySinh.ToString("dd/MM/yyyy")</td>
                                <td>@item.Email</td>
                                <td class="btn-actions">
                                    <a href="/NguoiNhan/Edit/@item.MaNguoiNhan" class="btn btn-sm btn-outline-warning">Sửa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Không có dữ liệu người nhận nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
